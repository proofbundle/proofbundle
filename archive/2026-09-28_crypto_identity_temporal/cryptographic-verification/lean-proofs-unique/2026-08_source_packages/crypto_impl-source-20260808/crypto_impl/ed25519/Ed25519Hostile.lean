/-- Companion predicate for case `S_zero`: S = 0 is technically canonical (0 < L); the rejection comes from the group equation, pinned by the main theorem. -/
theorem hostile_S_zero_predicate : isCanonicalS (sigScalar hostile_S_zero_sig) = true := by
  native_decide

/-- Companion predicate for case `S_equals_L`: S = L is non-canonical (malleability); rejected by isCanonicalS. -/
theorem hostile_S_equals_L_predicate : isCanonicalS (sigScalar hostile_S_equals_L_sig) = false := by
  native_decide

/-- Companion predicate for case `S_equals_L_plus_1`: S = L+1 is non-canonical; rejected by isCanonicalS. -/
theorem hostile_S_equals_L_plus_1_predicate : isCanonicalS (sigScalar hostile_S_equals_L_plus_1_sig) = false := by
  native_decide

/-- Companion predicate for case `S_max_2_255`: S = 2^256-1 is a non-canonical overflow scalar; rejected by isCanonicalS. -/
theorem hostile_S_max_2_255_predicate : isCanonicalS (sigScalar hostile_S_max_2_255_sig) = false := by
  native_decide

/-- Companion predicate for case `high_bit_S_set`: S with bit 255 set exceeds the group order; rejected by isCanonicalS. -/
theorem hostile_high_bit_S_set_predicate : isCanonicalS (sigScalar hostile_high_bit_S_set_sig) = false := by
  native_decide

/-- Companion predicate for case `non_canonical_R_y_plus_p`: adding `p`
to the original y-coordinate carried past `2^255`, so the x sign bit is
flipped (`v / 2^255 = 1`) while the low 255 bits stay below `p`.  The
encoding therefore still decodes (canonicality alone does not catch it),
but it decodes to the *wrong* x, and the cofactorless group equation of
RFC 8032 section 5.1.7 rejects it — pinned by the main theorem above. -/
theorem hostile_non_canonical_R_y_plus_p_predicate :
    isCanonicalPointEncoding (sigR hostile_non_canonical_R_y_plus_p_sig) = true ∧
    decodeInt (sigR hostile_non_canonical_R_y_plus_p_sig) / 2^255 = 1 := by
  native_decide

/-- Companion predicate for case `R_identity_encoding`: R = 01 00 ... 00 is the identity encoding: one of the eight small-order encodings. -/
theorem hostile_R_identity_encoding_predicate : isSmallOrder (sigR hostile_R_identity_encoding_sig) = true := by
  native_decide

/-- Companion predicate for case `A_identity`: Public key 01 00 ... 00 is the identity: a small-order public key. -/
theorem hostile_A_identity_predicate : isSmallOrder hostile_A_identity_pk = true := by
  native_decide

