/-
# RFC 8032 Ed25519 — Theorems: SHA-512 known-answer tests, signature
# KATs, and curve sanity theorems

Compile with `lake env lean Ed25519Theorems.lean` (with `Ed25519.lean` in
the same source root and the import below).  This file contains no
`sorry`, no `admit` and no `axiom`; every theorem is closed by
`native_decide` (or `rfl`) over the executable definitions of
`Ed25519.lean`.

Contents:

  * Part 1: SHA-512 known-answer tests — the three FIPS 180-4 examples
    (the empty string, "abc", and the 896-bit message), each with its
    published digest;
  * Part 2: all sixteen Ed25519 signature vectors from the project
    ground truth (`ground_truth.json`, dual-verified against OpenSSL and
    an independent pure-Python model): for each vector, public-key
    derivation, signing, and verification acceptance are pinned down by
    computation;
  * Part 3: curve sanity theorems — the base point is on the curve, the
    base point has order `L` (`L·B = identity`), the parameter identity
    `d = -121665/121666 (mod p)`, `I^2 = -1 (mod p)`, and `By = 4/5`.

Every secret key, public key, message, and signature below is written as
an explicit `ByteArray.mk #[...]` literal transcribed from the ground
truth, so the file is self-contained and auditable byte by byte.
-/

import Std
import Ed25519

namespace ProofBundle.Crypto.Ed25519

/-!
## Part 1: SHA-512 known-answer tests (FIPS 180-4 appendix D)
-/

/-- FIPS 180-4 SHA-512 example 1: the empty string. -/
theorem sha512_kat_empty :
    sha512Hex "" =
      "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce" ++
      "47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" := by
  native_decide

/-- FIPS 180-4 SHA-512 example 2: the one-block message "abc". -/
theorem sha512_kat_abc :
    sha512Hex "abc" =
      "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" ++
      "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" := by
  native_decide

/-- FIPS 180-4 SHA-512 example 3: the 896-bit (112-byte) message
"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
which pads to two blocks because the 128-bit length field no longer fits
in the first block. -/
theorem sha512_kat_896bit :
    sha512Hex "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu" =
      "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018" ++
      "501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909" := by
  native_decide

