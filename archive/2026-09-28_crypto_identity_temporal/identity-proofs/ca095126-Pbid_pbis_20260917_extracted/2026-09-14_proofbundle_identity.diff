+
+/* Sign a payload as a model name. Calls run one at a time so a batch cannot
+   race key creation or interleave action-chain entries. */
+function signAs(model, payload, digestAlg = 'SHA3-256', sigAlg) {
+  const run = _idSignQueue.then(async () => {
+    const { identity } = await establishIdentity(model, sigAlg);
+    const key = await idKey(identity.model);
+    const bundle = await idSealAttest(idGet(identity.model), key, payload, digestAlg);
+    await registerBundle(bundle, 'sign-as');
+    return bundle;
+  });
+  _idSignQueue = run.catch(() => {});
+  return run;
+}
+
+/* ── registry ─────────────────────────────────────────────────────── */
+async function idSealRegistry(opRec, opKey, recs, digestAlg) {
+  const entries = recs.map(r => ({
+    model: idCheckName(r.model), sig_alg: r.sig_alg, pub_b64u: r.pub, key_sha256: r.key_sha256,
+    key_fingerprint: r.key_sha256.slice(0, 16), status: 'active', attestation: 'operator',
+    attested_by: opRec.key_sha256,
+  })).sort((a, b) => { const x = a.model + '|' + a.key_sha256, y = b.model + '|' + b.key_sha256; return x < y ? -1 : x > y ? 1 : 0; });
+  const bundle = {
+    hdr: { profile: PB_ID_REGISTRY_PROFILE },
+    meta: { registry_operator: { label: opRec.model, key_sha256: opRec.key_sha256 } },
+    payload: { spec: PB_ID_REGISTRY_PROFILE, entries },
+  };
+  return sealCore(bundle, digestAlg || 'SHA3-256', opKey.alg, opKey);
