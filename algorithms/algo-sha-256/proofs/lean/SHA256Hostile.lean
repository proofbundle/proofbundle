/-
Hostile / adversarial test vectors for SHA256

All proofs are closed by `rfl`.  These vectors exercise padding boundaries,
delimiter ambiguity, and alphabet coverage.
-/ 

import Crypto.SHA256

namespace Crypto.SHA256

set_option maxRecDepth 16000
set_option maxHeartbeats 4000000

/-- 55-byte message: longest message fitting one padded block. -/
theorem hostile_len_55 :
  sha256Bytes (List.replicate 55 0x00) =
  [0x02, 0x77, 0x94, 0x66, 0xcd, 0xec, 0x16, 0x38,
   0x11, 0xd0, 0x78, 0x81, 0x5c, 0x63, 0x3f, 0x21,
   0x90, 0x14, 0x13, 0x08, 0x14, 0x49, 0x00, 0x2f,
   0x49, 0x10, 0x5d, 0x08, 0x1f, 0x1c, 0x2f, 0x57] := rfl

/-- Single 0x80 byte: tests delimiter-only padding ambiguity. -/
theorem hostile_single_0x80 :
  sha256Bytes [0x80] =
  [0x6e, 0x0f, 0x19, 0x0d, 0x41, 0x03, 0x34, 0x87,
   0xe3, 0x59, 0x55, 0xf5, 0x31, 0x8a, 0x81, 0x05,
   0x06, 0x80, 0x11, 0xc5, 0x19, 0x1e, 0x78, 0x76,
   0x43, 0x06, 0x16, 0xca, 0x61, 0x25, 0x6a, 0x26] := rfl

end Crypto.SHA256
