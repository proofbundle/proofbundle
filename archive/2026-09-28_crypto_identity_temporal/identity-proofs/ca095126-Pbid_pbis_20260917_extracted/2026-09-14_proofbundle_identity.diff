+               fingerprint: r.fingerprint, created_at: r.created_at, private_loaded: _idPriv.has(name) } : null;
+}
+function idSignerBlock(rec) {
+  return { model: rec.model, sig_alg: rec.sig_alg, key_sha256: rec.key_sha256,
+           key_fingerprint: rec.key_sha256.slice(0, 16), key_custody: 'operator' };
+}
+async function idMakeRecord(model, key) {
+  const key_sha256 = await idKeySha256(key.pub);
+  return { model: idCheckName(model), sig_alg: key.alg, pub: key.pub, key_sha256, fingerprint: key_sha256.slice(0, 16) };
+}
+async function idKey(model) {
+  const rec = idGet(model), held = _idPriv.get(model);
+  if (!rec) throw new Error(`no identity "${model}" in this browser`);
+  if (!held) throw new Error(`identity "${model}" (fp ${rec.fingerprint}) has no private key loaded in this tab; import the keyring file. No replacement key was made.`);
+  const now = await idKeySha256(rec.pub);
+  if (now !== held.key_sha256 || now !== rec.key_sha256)
+    throw new Error(`identity "${model}": stored public key does not match the loaded private key; refusing to sign`);
+  return { alg: rec.sig_alg, priv: held.priv, pub: rec.pub };
