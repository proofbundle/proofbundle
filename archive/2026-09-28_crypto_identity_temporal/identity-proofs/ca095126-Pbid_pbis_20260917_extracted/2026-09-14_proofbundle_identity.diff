+
+/* Create on first use; reuse after. Never replaces an existing key. */
+async function establishIdentity(model, sigAlg) {
+  const name = idCheckName(model);
+  while (_idCreating.has(name)) await _idCreating.get(name).catch(() => {});
+  const have = idGet(name);
+  if (have) {
+    if (sigAlg && sigAlg !== have.sig_alg)
+      throw new Error(`identity "${name}" already uses ${have.sig_alg} (fp ${have.fingerprint}); asked for ${sigAlg}. Keys are not replaced implicitly; remove the identity to start over.`);
