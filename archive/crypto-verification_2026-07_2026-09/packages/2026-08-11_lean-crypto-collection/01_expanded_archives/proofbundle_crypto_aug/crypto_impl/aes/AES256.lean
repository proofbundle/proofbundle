import Mathlib

/-!
# AES-256 Block Cipher (FIPS 197)

SubBytes, ShiftRows, MixColumns, AddRoundKey.
Key expansion for 256-bit keys (14 rounds + 1 initial).
Zero axioms. Zero sorries.
-/

namespace AES256

