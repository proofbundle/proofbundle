# ProofBundle web bridge — user service. NOT installed/enabled by default.
# To use: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now proofbundle-web-bridge
[Unit]
Description=ProofBundle web bridge (sealing bridge + dashboard, 127.0.0.1:8788)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/falsealias/src/proofbundle/agent
ExecStart=/usr/bin/env node /home/falsealias/src/proofbundle/agent/web-bridge.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
