+    await chainAppend('identity-create', name, `${alg} · fp ${rec.fingerprint} · private key held in this tab until exported`);
+    renderIdentityPanel();
+    return { created: true, identity: idPublic(name) };
+  })();
+  _idCreating.set(name, creation);
+  try { return await creation; } finally { _idCreating.delete(name); }
