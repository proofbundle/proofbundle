/-- SubBytes: apply S-box to each byte. -/
def subBytes (st : State) : State :=
  fun r c => sBox (st r c)

/-- ShiftRows: rotate each row left by row index. -/
def shiftRows (st : State) : State :=
  fun r c => st r ⟨ (c.val + r.val) % 4, by omega ⟩

/-- xtime: multiply by x in GF(2^8). -/
def xtime (b : UInt8) : UInt8 :=
  let n := b.toNat
  let shifted := n * 2
  if shifted ≥ 256 then
    UInt8.ofNat ((shifted % 256) ^^^ 0x1b)
  else
    UInt8.ofNat shifted

/-- Multiply two bytes in GF(2^8). -/
def gmul (a b : UInt8) : UInt8 :=
  let mut result := 0
  let mut aa := a.toNat
  let mut bb := b.toNat
  for _ in [0:8] do
    if bb &&& 1 = 1 then
      result := result ^^^ aa
    let carry := aa &&& 0x80
    aa := (aa * 2) % 256
    if carry ≠ 0 then
      aa := aa ^^^ 0x1b
    bb := bb / 2
  UInt8.ofNat (result % 256)

/-- MixColumns: matrix multiplication in GF(2^8). -/
def mixColumns (st : State) : State :=
  fun r c =>
    let s0 := st 0 c
    let s1 := st 1 c
    let s2 := st 2 c
    let s3 := st 3 c
    match r.val with
    | 0 => gmul 0x02 s0 ^^^ gmul 0x03 s1 ^^^ s2 ^^^ s3
    | 1 => s0 ^^^ gmul 0x02 s1 ^^^ gmul 0x03 s2 ^^^ s3
    | 2 => s0 ^^^ s1 ^^^ gmul 0x02 s2 ^^^ gmul 0x03 s3
    | 3 => gmul 0x03 s0 ^^^ s1 ^^^ s2 ^^^ gmul 0x02 s3
    | _ => st r c

/-- AddRoundKey: XOR state with round key. -/
def addRoundKey (st : State) (roundKey : State) : State :=
  fun r c => st r c ^^^ roundKey r c

/-- Round constant for key expansion (FIPS 197 Figure 5). -/
def rCon (i : Nat) : UInt8 :=
  match i with
  | 0 => 0x01 | 1 => 0x02 | 2 => 0x04 | 3 => 0x08
  | 4 => 0x10 | 5 => 0x20 | 6 => 0x40 | 7 => 0x80
  | 8 => 0x1b | 9 => 0x36 | _ => 0x00

/-- Rotate word left by 1 byte. -/
def rotWord (w : Fin 4 → UInt8) : Fin 4 → UInt8 :=
  fun i => w ⟨ (i.val + 1) % 4, by omega ⟩

/-- SubWord: apply S-box to each byte of a word. -/
def subWord (w : Fin 4 → UInt8) : Fin 4 → UInt8 :=
  fun i => sBox (w i)

/-- Key expansion for AES-256.
    32-byte key -> 15 round keys (60 words = 240 bytes). -/
def keyExpansion (key : Array UInt8) : Array State :=
  let mut words := Array.mkArray 60 (fun (_ : Fin 4) => (0 : UInt8))
  -- Initialize first 8 words from key
  for i in [0:8] do
    let w := fun j => key[i * 4 + j.val]!
    words := words.set! i w
  -- Expand remaining words
  for i in [8:60] do
    let mut temp := words[i - 1]!
    if i % 8 = 0 then
      temp := subWord (rotWord temp)
      temp := fun j => if j.val = 0 then temp j ^^^ rCon (i / 8 - 1) else temp j
    else if i % 8 = 4 then
      temp := subWord temp
    words := words.set! i (fun j => words[i - 8]! j ^^^ temp j)
  -- Group into 15 round keys (States)
  let mut roundKeys := Array.mkArray 15 (fun (_ : Fin 4) (_ : Fin 4) => (0 : UInt8))
  for round in [0:15] do
    let rk := fun r c => words[round * 4 + c.val]! r
    roundKeys := roundKeys.set! round rk
  roundKeys

/-- Encrypt one 16-byte block. -/
def encryptBlock (key : Array UInt8) (block : Array UInt8) : Array UInt8 :=
  let roundKeys := keyExpansion key
  let mut st : State := fun r c =>
    block[r.val * 4 + c.val]!
  -- Initial AddRoundKey
  st := addRoundKey st (roundKeys[0]!)
  -- 13 main rounds
  for round in [1:14] do
    st := subBytes st
    st := shiftRows st
    st := mixColumns st
    st := addRoundKey st (roundKeys[round]!)
  -- Final round (no MixColumns)
  st := subBytes st
  st := shiftRows st
  st := addRoundKey st (roundKeys[14]!)
  -- Serialize state to bytes
  let mut output := Array.mkArray 16 (0 : UInt8)
  for r in [0:4] do
    for c in [0:4] do
      output := output.set! (r * 4 + c) (st ⟨r, by omega⟩ ⟨c, by omega⟩)
  output

end AES256
