+/* ── keyring file ─────────────────────────────────────────────────── */
+function idKeyringDoc() {
+  const identities = Object.keys(STATE.identities).sort().map(n => {
+    const r = STATE.identities[n], held = _idPriv.get(n);
+    const row = { model: n, sig_alg: r.sig_alg, pub_b64u: r.pub, key_sha256: r.key_sha256,
+                  key_fingerprint: r.fingerprint, created_at: r.created_at || null };
+    if (held) row.priv_b64u = held.priv;
+    return row;
+  });
+  return { kind: 'proofbundle-identity-keyring', v: 1, exported_at: new Date().toISOString(),
+    warning: 'PRIVATE KEY MATERIAL: anyone holding this file can sign as every identity in it',
+    private_keys_missing: identities.filter(r => !r.priv_b64u).map(r => r.model), identities };
+}
+async function idImportKeyring(doc) {
+  if (!doc || doc.kind !== 'proofbundle-identity-keyring' || doc.v !== 1 || !Array.isArray(doc.identities))
+    throw new Error('not a proofbundle identity keyring (kind, v, identities)');
+  const loaded = [], publicOnly = [], skipped = [];
+  for (const row of doc.identities) {
+    const model = row && row.model;
+    try {
+      idCheckName(model);
+      if (!sigInfo(row.sig_alg)) throw new Error('unknown sig_alg ' + JSON.stringify(row.sig_alg));
+      if (typeof row.pub_b64u !== 'string' || !row.pub_b64u) throw new Error('missing pub_b64u');
+      const ks = await idKeySha256(row.pub_b64u);
+      if (row.key_sha256 !== undefined && row.key_sha256 !== ks) throw new Error('key_sha256 does not match pub_b64u');
+      const have = idGet(model);
+      if (have && (have.key_sha256 !== ks || have.sig_alg !== row.sig_alg))
+        throw new Error(`this browser already binds the name to key ${have.fingerprint} (${have.sig_alg}); remove it first to replace it`);
+      if (typeof row.priv_b64u === 'string' && row.priv_b64u) {
+        await idRoundTrip(row.sig_alg, row.priv_b64u, row.pub_b64u);
+        _idPriv.set(model, { priv: row.priv_b64u, key_sha256: ks });
+        loaded.push(model);
+      } else publicOnly.push(model);
+      if (!have) STATE.identities[model] = { model, sig_alg: row.sig_alg, pub: row.pub_b64u, key_sha256: ks,
+        fingerprint: ks.slice(0, 16), created_at: typeof row.created_at === 'string' ? row.created_at : null };
+    } catch (e) { skipped.push({ model: String(model), why: e.message }); }
+  }
+  idPersist();
+  await chainAppend('identity-import', `${loaded.length + publicOnly.length} identities`,
+    `${loaded.length} with private keys · ${publicOnly.length} public-only · ${skipped.length} skipped`);
+  renderIdentityPanel();
+  return { loaded, publicOnly, skipped };
