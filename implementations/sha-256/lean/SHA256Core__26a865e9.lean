  lor (land x y) (land (4294967295 - mask32 x) z)

def Maj (x y z : Word) : Word :=
  lor (lor (land x y) (land x z)) (land y z)

def bigSigma0 (x : Word) : Word := xor (xor (rotr x 2) (rotr x 13)) (rotr x 22)
def bigSigma1 (x : Word) : Word := xor (xor (rotr x 6) (rotr x 11)) (rotr x 25)
def smallSigma0 (x : Word) : Word := xor (xor (rotr x 7) (rotr x 18)) (shr x 3)
def smallSigma1 (x : Word) : Word := xor (xor (rotr x 17) (rotr x 19)) (shr x 10)

