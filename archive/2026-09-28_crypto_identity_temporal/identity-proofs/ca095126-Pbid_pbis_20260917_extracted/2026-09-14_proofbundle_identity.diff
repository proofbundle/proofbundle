+
+async function idForget(model) {
+  const rec = idGet(model);
+  if (!rec) return false;
+  delete STATE.identities[model];
+  _idPriv.delete(model);
+  idPersist();
+  await chainAppend('identity-remove', model, `fp ${rec.fingerprint} removed from this browser`);
+  renderIdentityPanel();
+  return true;
