+/* ── sealing ──────────────────────────────────────────────────────── */
+async function idSealAttest(rec, key, payload, digestAlg) {
+  const bundle = {
+    hdr: { profile: PB_ID_ATTEST_PROFILE },
+    meta: { signer: idSignerBlock(rec) },
+    payload: payload === undefined ? {} : payload,
+  };
+  idAssertJsonStable(bundle);
+  return sealCore(bundle, digestAlg || 'SHA3-256', key.alg, key);
