      ByteArray.mk #[
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00] := by
  native_decide

/-- The base point encodes to the published 32-byte string `586666...66`
(RFC 8032 section 3: "the little-endian encoding of `4/5` ... `5866...`"). -/
theorem basePoint_encode :
    hexEncode (encodePoint basePoint) =
      "5866666666666666666666666666666666666666666666666666666666666666" := by
  native_decide

end ProofBundle.Crypto.Ed25519
