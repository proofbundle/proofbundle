+/* ══════════════════════════════════════════════════════════════════
+   MODEL IDENTITY — patch 2026-09-14
+   PB-MODEL-ATTEST-1 (bundles signed as a model name)
+   PB-MODEL-REGISTRY-1 (signed list of name → key)
+
+   What it does
+   · One signing key per model name. Created on first use, reused after,
+     never replaced implicitly. Removing a name is an explicit action.
+   · Public halves persist in localStorage ('proofbundle.identity.v1').
+     Private halves stay in this tab's memory, the same rule as _currentKey.
+     Move them with Export keyring / Import keyring. After a reload, signing
+     under a name whose private key is not loaded fails; no new key is made.
+   · meta.signer = { model, sig_alg, key_sha256, key_fingerprint, key_custody }
+     is inside the signed bytes. key_sha256 is the full SHA-256 of the public
+     key and is what verification compares. key_fingerprint (first 16 hex)
+     is for display only: 64 bits is too short to anchor a name.
+
+   What it proves and what it does not
+   · Verify checks that key_sha256 is the key that actually verified the
+     signature (pubOverride included). That shows which key signed.
+   · It does not show who holds the key. Anyone can generate a key and write
+     any model name. A name is checked only against a registry sealed by a
+     key the verifier pins by its full SHA-256. key_custody "operator" means
+     the person running this tool holds the keys, not the model or its
+     provider. Provider-signed entries are not accepted by this build.
+
+   Verify outcomes (existing classes only)
+     meta.signer malformed                          → MALFORMED
+     declared key is not the key that verified      → INVALID-SIGNATURE
+     registry lists the name under other keys only  → INVALID-SIGNATURE
+     registry does not list the name                → POLICY-DENIED
+     no pinned registry, everything else VERIFIED   → MISSING-SIDE-INFO
+   ══════════════════════════════════════════════════════════════════ */
+const PB_ID_LS_KEY = 'proofbundle.identity.v1';
+const PB_ID_ATTEST_PROFILE = 'PB-MODEL-ATTEST-1';
+const PB_ID_REGISTRY_PROFILE = 'PB-MODEL-REGISTRY-1';
+const PB_ID_NAME_RE = /^[a-z0-9][a-z0-9._:\/@+-]{0,127}$/;
+const PB_ID_HEX64_RE = /^[0-9a-f]{64}$/;
+STATE.identities = Object.create(null);   /* model → public record (persisted) */
+const _idPriv = new Map();                 /* model → { priv, key_sha256 } (memory only) */
+const _idCreating = new Map();             /* model → in-flight key creation */
+const _idRegistryBrand = new WeakSet();    /* registry objects produced by idLoadRegistry */
+let _idSignQueue = Promise.resolve();      /* signAs calls run one at a time */
+let idActiveRegistry = null;               /* pinned registry used by Verify and store checks in this tab */
+
+function idEsc(s) {
+  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+}
+function idGet(name) {
+  return Object.prototype.hasOwnProperty.call(STATE.identities, name) ? STATE.identities[name] : null;
+}
+function idCheckName(model) {
+  if (typeof model !== 'string' || !PB_ID_NAME_RE.test(model))
+    throw new Error('model name must be 1–128 characters from a-z 0-9 . _ : / @ + - and start with a letter or digit; got ' + JSON.stringify(model));
+  return model;
+}
+function idLocalDate() {
+  const d = new Date();
+  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
+}
