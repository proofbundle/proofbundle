+/* ── storage ──────────────────────────────────────────────────────── */
+function idPersist() {
+  if (!lsAvail()) return false;
+  try { localStorage.setItem(PB_ID_LS_KEY, JSON.stringify({ v: 1, identities: STATE.identities })); return true; }
+  catch (e) { console.warn('identity persist failed:', e.message); return false; }
+}
+function idRestore() {
+  STATE.identities = Object.create(null);
+  if (!lsAvail()) return false;
+  try {
+    const raw = localStorage.getItem(PB_ID_LS_KEY);
+    if (!raw) return false;
+    const s = JSON.parse(raw);
+    if (!s || s.v !== 1 || !s.identities || typeof s.identities !== 'object') return false;
+    for (const [name, r] of Object.entries(s.identities)) {
+      const shapeOk = r && r.model === name && PB_ID_NAME_RE.test(name) && sigInfo(r.sig_alg) &&
+        typeof r.pub === 'string' && typeof r.key_sha256 === 'string' && PB_ID_HEX64_RE.test(r.key_sha256);
