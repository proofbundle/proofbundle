+
+/* Every listed key must have its private half loaded in this tab. idKey ties
+   that private half to the stored public key, so a public record altered in
+   localStorage cannot be written into a registry the operator signs. */
+async function idBuildRegistry(operatorName, modelNames, digestAlg) {
+  const opKey = await idKey(idCheckName(operatorName));
+  const recs = [];
+  for (const n of [...new Set(modelNames)]) { await idKey(idCheckName(n)); recs.push(idGet(n)); }
+  if (!recs.length) throw new Error('no model identities to list');
+  const reg = await idSealRegistry(idGet(operatorName), opKey, recs, digestAlg);
+  await registerBundle(reg, 'identity-registry');
+  return reg;
+}
