/-- The base point lies on the Ed25519 curve:
`-Bx^2 + By^2 = 1 + d*Bx^2*By^2 (mod p)` (RFC 8032 section 3). -/
theorem basePoint_on_curve : onCurve basePoint = true := by
  native_decide

/-- The base point has order `L`: `L·B` is the identity point `(0, 1)`
(RFC 8032 section 3: "`B` ... generates a subgroup whose order is `L`").
The fuel of `scalarmult` (512) comfortably covers the 253-bit scalar `L`;
see the docstring of `scalarmult`. -/
theorem basePoint_order_L : scalarmult basePoint L = identityPoint := by
  native_decide

/-- The curve parameter relation `d = -121665/121666 (mod p)` (RFC 8032
section 3), stated without division as `121666 * d + 121665 = 0 (mod p)`. -/
theorem d_eq_neg_ratio : (121666 * d + 121665) % p = 0 := by
  native_decide

/-- `I` is a square root of `-1` modulo `p` (RFC 8032 section 3). -/
theorem I_sq_eq_neg_one : fmul I I = fsub 0 1 := by
  native_decide

/-- The base-point y-coordinate is `4/5 (mod p)` (RFC 8032 section 3),
stated without division as `5 * By = 4 (mod p)`. -/
theorem By_eq_four_fifths : (5 * By) % p = 4 := by
  native_decide

/-- The group order has the published form
`L = 2^252 + 27742317777372353535851937790883648493` (RFC 8032
section 3). -/
theorem L_eq : L = 2^252 + 27742317777372353535851937790883648493 := by
  native_decide

