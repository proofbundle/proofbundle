def rotr (x : Word) (n : Nat) : Word :=
  mask32 ((x / (2 ^ n)) + (x % (2 ^ n)) * (2 ^ (32 - n)))

def shr (x : Word) (n : Nat) : Word := x / (2 ^ n)

