+  return hexOf(await digestBytes('SHA-256', b64uDecode(pubB64u)));
+}
+async function idRoundTrip(alg, privB64u, pubB64u) {
+  const msg = utf8('PB-MODEL-ATTEST-1 key check ' + pubB64u);
+  const sig = await sigSign(alg, msg, privB64u);
+  const ok = await sigVerify(alg, msg, sig, pubB64u);
