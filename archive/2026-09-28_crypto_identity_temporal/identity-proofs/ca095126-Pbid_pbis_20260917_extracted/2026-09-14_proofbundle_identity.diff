+  let rt;
+  try { rt = JSON.parse(JSON.stringify(obj)); }
+  catch (e) { throw new Error('bundle is not JSON-serializable: ' + e.message); }
+  if (canonicalJSON(rt) !== canonicalJSON(obj))
+    throw new Error('payload holds values that change when written as JSON (undefined, functions, Dates); the seal would not verify after download');
+}
